{
  "name": "mytax-mapper-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "ios:add": "cap add ios",
    "ios:sync": "npm run build && cap sync ios && xattr -cr ios/App/App",
    "ios:dev": "CAP_DEV_URL=${CAP_DEV_URL:-http://localhost:5173} cap sync ios && xattr -cr ios/App/App",
    "ios:assets": "capacitor-assets generate --ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@tanstack/react-query": "^5.59.0",
    "antd": "^5.21.4",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
